[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="Jack"
3d_physics/layer_3="Interactables"

[rendering]

anti_aliasing/quality/msaa_3d=2
; ETC2/ASTC and S3TC/BPTC are the two texture-compression families a *universal*
; macOS build needs: Apple Silicon wants ETC2, Intel Macs want S3TC. Godot
; refuses to export a universal binary unless both importers are enabled.
; The setting only affects imported textures, and this project has none -- every
; mesh and icon is generated in code -- so it costs nothing at runtime and is
; what makes a single .app run on both kinds of Mac.
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
; Night skies are the worst case for colour banding: a dark gradient over most of
; the screen. Debanding costs almost nothing and removes the visible rings.
anti_aliasing/quality/use_debanding=true
anti_aliasing/quality/screen_space_aa=0
; 3 = the "soft" shadow filter. The game is made of big rounded primitives lit by
; one moon, so a soft penumbra is what makes them read as solid objects.
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/size=4096
