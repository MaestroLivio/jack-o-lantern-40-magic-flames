# Godot 4 editor and import caches. Both are regenerated on the next scan and
# both contain absolute paths and a machine-specific import hash, so committing
# them makes the repository machine-specific. The `.import` files are ignored
# too: the only setting in them that matters here is the music's loop flag, and
# `Music.gd` sets that on the stream when it loads. A fresh clone therefore
# imports the same audio with the same behaviour. (`*.uid` files are NOT ignored:
# they are how a .tscn keeps pointing at the same script after a rename.)
.godot/
*.import

# Screenshots produced by tools/screenshot*.gd and tools/gfx_probe.gd.
_shots/

# Build output. `dist/` is ~340 MB of installers, rebuilt from the sources next
# to this file; `build/music/` holds 27 MB of intermediate WAVs that
# tools/make_music.py recreates from the Python script, and the iconset is
# regenerated by tools/make_app_icon.gd.
dist/
build/music/
build/icon/jack.iconset/
build/dmg/

# The generated installers' checksum list changes with every build.
SHA256SUMS.txt

# The Piper voices themselves: 113 MB per model, needed only to regenerate
# `assets/voice/`, and downloaded by hand (see tools/VOICE_MODELS.md). The
# *result* -- the Ogg clips and voice_pack.json -- is committed, because that is
# what ships.
*.onnx
*.onnx.json

# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store
